# ============================================================================
# QBENCH WEBSITE — ENVIRONMENT CONFIGURATION (.env.example)
# Target Enquiry Inbox: qbench.official@gmail.com
# ============================================================================

# 1. GOOGLE AI STUDIO SECRETS — EMAILJS + GOOGLE SHEETS CRM (REQUIRED)
EMAILJS_PUBLIC_KEY="your_emailjs_public_key"
EMAILJS_SERVICE_ID="your_emailjs_service_id"
EMAILJS_ADMIN_TEMPLATE_ID="your_emailjs_admin_template_id"
EMAILJS_AUTO_REPLY_TEMPLATE_ID="your_emailjs_auto_reply_template_id"
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# Optional Vite-prefixed aliases (automatically mapped by vite.config.ts)
VITE_EMAILJS_PUBLIC_KEY="your_emailjs_public_key"
VITE_EMAILJS_SERVICE_ID="your_emailjs_service_id"
VITE_EMAILJS_ADMIN_TEMPLATE_ID="your_emailjs_admin_template_id"
VITE_EMAILJS_AUTO_REPLY_TEMPLATE_ID="your_emailjs_auto_reply_template_id"
VITE_GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# 2. GMAIL SMTP CONFIGURATION (Optional Server-Side Backup)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="qbench.official@gmail.com"
SMTP_PASS="your-16-char-google-app-password"

# 3. ADMIN CRM PORTAL SECRET
ADMIN_SECRET="some-secure-random-key"

# 4. PLATFORM VARIABLES
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
