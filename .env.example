# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Google Sheets + Google Apps Script Webhook URL (Primary Source of Truth & Email Notification Pipeline)
# Website Contact Form -> GOOGLE_SHEETS_WEBHOOK_URL -> Google Sheet -> Apps Script (MailApp) -> qbench.official@gmail.com
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# Optional Zapier Lead Automation Webhook
ZAPIER_WEBHOOK_URL=

# Admin Key to review saved database messages securely via /api/messages?secret=YOUR_SECRET
ADMIN_SECRET="some-secure-random-key"
