# ============================================================================
# QBENCH CREATIVE AGENCY — ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================

# 1. SUPABASE CONFIGURATION (FRONTEND ANON KEY ONLY — NEVER EXPOSE SERVICE_ROLE KEY)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional alias supported by Vite config:
VITE_SUPABASE_PUBLISHABLE_KEY=

# 2. EMAILJS + GOOGLE SHEETS CRM (OPTIONAL)
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_ADMIN_TEMPLATE_ID=
EMAILJS_AUTO_REPLY_TEMPLATE_ID=
GOOGLE_SHEETS_WEBHOOK_URL=

# 3. WHATSAPP BUSINESS CLOUD API (OPTIONAL SERVER-SIDE)
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=

# 4. GMAIL SMTP CONFIGURATION (OPTIONAL SERVER-SIDE)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
