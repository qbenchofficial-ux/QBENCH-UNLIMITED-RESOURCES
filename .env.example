# ============================================================================
# QBENCH WEBSITE — ENVIRONMENT CONFIGURATION (.env.example)
# Target Enquiry Inbox: qbench.official@gmail.com
# ============================================================================

# 0. SUPABASE CLIENT CONFIGURATION (PUBLISHABLE KEY ONLY — NEVER USE SECRET OR SERVICE_ROLE KEY)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# 1. GOOGLE AI STUDIO SECRETS — EMAILJS + GOOGLE SHEETS CRM (REQUIRED)
EMAILJS_PUBLIC_KEY="your_emailjs_public_key"
EMAILJS_SERVICE_ID="your_emailjs_service_id"
EMAILJS_ADMIN_TEMPLATE_ID="your_emailjs_admin_template_id"
EMAILJS_AUTO_REPLY_TEMPLATE_ID="your_emailjs_auto_reply_template_id"
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# Optional Vite-prefixed aliases (automatically mapped by vite.config.ts)
VITE_EMAILJS_PUBLIC_KEY="your_emailjs_public_key"
VITE_EMAILJS_SERVICE_ID="your_emailjs_service_id"
VITE_EMAILJS_ADMIN_TEMPLATE_ID="your_emailjs_admin_template_id"
VITE_EMAILJS_AUTO_REPLY_TEMPLATE_ID="your_emailjs_auto_reply_template_id"
VITE_GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# 2. WHATSAPP BUSINESS CLOUD API SECRETS (SERVER-SIDE ONLY — NEVER EXPOSED IN FRONTEND)
WHATSAPP_API_URL="https://graph.facebook.com/v20.0"
WHATSAPP_ACCESS_TOKEN="your_whatsapp_cloud_api_access_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_RECIPIENT_NUMBER="917356525932"
WHATSAPP_TEMPLATE_NAME="qbench_new_enquiry"
WHATSAPP_TEMPLATE_LANGUAGE="en"

# 3. GMAIL SMTP CONFIGURATION (Optional Server-Side Backup)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="qbench.official@gmail.com"
SMTP_PASS="your-16-char-google-app-password"

# 4. ADMIN CRM PORTAL SECRET
ADMIN_SECRET="some-secure-random-key"

# 5. PLATFORM VARIABLES
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
